    {
      "name": "Register Donor",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Donor\",\n  \"email\": \"newdonor@example.com\",\n  \"password\": \"demo12345\",\n  \"dateOfBirth\": \"1995-06-15\",\n  \"gender\": \"Female\",\n  \"idType\": \"Ghana_Card\",\n  \"idNumber\": \"GHA-123456789-0\",\n  \"agreeToTerms\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register/donor",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register", "donor"]
        }
      },
      "response": []
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        }
      },
      "response": []
    },
    {
      "name": "Get Current User",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      },
      "response": []
    },
    {
      "name": "Verify Staff Action",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/verify-staff-action",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "verify-staff-action"]
        }
      },
      "response": []
    },
    {
      "name": "Change Password",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"demo123\",\n  \"newPassword\": \"demo12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/change-password",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "change-password"]
        }
      },
      "response": []
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        }
      },
      "response": []
    }
  ]
}
